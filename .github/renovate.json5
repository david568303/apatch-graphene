{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':dependencyDashboard',
  ],
  ignorePresets: [
    'helpers:pinGitHubActionDigests',
  ],
  prHourlyLimit: 0,
  labels: [
    'dependencies',
  ],
  vulnerabilityAlerts: {
    labels: [
      'security',
      'dependencies',
    ],
  },
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      description: 'Automatically merge minor and patch-level updates',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      automerge: true,
    },
    {
      matchFileNames: [
        'rooted-ota.sh',
        '.github/workflows/release-single.yaml',
        '.github/workflows/renovate.yaml',
      ],
      matchPackageNames: [
        '!bmax121/APatch',
        '!bmax121/KernelPatch',
      ],
      description: 'Build tools shared with upstream rooted-graphene (avbroot, afsr, Custota, Python, my-avbroot-setup). The upstream merge sync that used to bring these was retired: the fork replaced the Magisk flavors with APatch, so merges only conflicted. They change how every OTA is built, so propose them together and never merge them automatically.',
      groupName: 'OTA build tools',
      automerge: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/rooted-ota.sh/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?_VERSION=(?<currentValue>.+?)\\s',
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: currentValue=(?<currentValue>[a-z-]+?))?\\s.+?_COMMIT=(?<currentDigest>.+?)\\s',
      ],
    },
  ],
}
